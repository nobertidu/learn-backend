PORT=3001
# where uploaded files are saved
UPLOAD_DIR=./uploads
# postgres connection string: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://learn:learnpass@localhost:5432/learn_deploy
# max upload size in MB
MAX_UPLOAD_MB=100
# allowed frontend origins for CORS, comma separated
CORS_ORIGINS=http://localhost:5173
